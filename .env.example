# Copy to .env for local use, or to .env.production for the server, and fill in.

PORT=3000

# Required. A long random string used to sign login tokens: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# SQLite file when running without Docker. (In the container it is always /data/chores.db.)
DB_PATH=test.db

# Only needed behind a reverse proxy that changes the Host header: your public origin(s), comma-separated
# TRUSTED_ORIGINS=https://chores.example.com

# Docker only (read by the .dev_scripts commands):
# HOST_PORT=3000        port published on the host
# BIND_ADDR=127.0.0.1   use 0.0.0.0 to expose the app beyond this machine
