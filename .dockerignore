# Keep the build context small and keep secrets and local data out of images.
.git
.gitignore
.idea
.claude

# Secrets and local state
.env
.env.*
!.env.example
*.db
*.db-*
backups/

# Generated by `templ generate` inside the image build
**/*_templ.go
**/*_templ.txt

# Not needed to build
.dev_scripts
Dockerfile
docker-compose.yml
.dockerignore
README.md
LICENSE
goDoChores
