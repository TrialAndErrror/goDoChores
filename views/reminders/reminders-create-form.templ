package reminders

import (
	"fmt"
	"goDoChores/models"
	"goDoChores/views/base"
)

templ remindersCreatePage(chores []models.Chore, intervals []string, selectedChore uint) {
	@views.Base("chores") {
		<div class="card" data-bs-theme="dark">
			<h2 class="card-header" style="padding: 1.5rem">
				Create Chore Reminder
			</h2>
			<div class="card-body">
				<form class="custom-form" method="post">
					<div class="form-group">
						<label for="choreID">Chore</label>
						<select id="choreID" name="choreID" class="form-control">
							for _, el := range chores {
								<option value={ fmt.Sprintf("%d", el.ID) } selected?={ el.ID == selectedChore }>{ el.Name }</option>
							}
						</select>
					</div>
					<div class="form-group">
						<label for="date">Date</label>
						<input type="date" class="form-control" id="date" name="date"/>
					</div>
					<div class="form-group">
						<label for="interval">Repeats</label>
						<select name="interval" id="interval" class="form-control">
							for _, interval := range intervals {
								<option value={ interval }>{ models.IntervalLabel(interval) }</option>
							}
						</select>
					</div>
					<div class="form-group" id="intervalValueGroup">
						<label for="intervalValue" id="intervalValueLabel">Every</label>
						<input type="number" min="1" max="999" class="form-control" id="intervalValue" name="intervalValue" value="1" required/>
						<small class="text-muted" id="intervalValueHelp"></small>
					</div>
					<script>
						(function () {
							const interval = document.getElementById("interval")
							const group = document.getElementById("intervalValueGroup")
							const input = document.getElementById("intervalValue")
							const label = document.getElementById("intervalValueLabel")
							const help = document.getElementById("intervalValueHelp")
							function sync() {
								const once = interval.value === "Once"
								const dom = interval.value === "DOM"
								group.hidden = once
								input.disabled = once
								input.max = dom ? 31 : 999
								label.innerText = dom ? "Day of the month" : "Every"
								help.innerText = dom ? "1-31. Short months use their last day." : ""
							}
							interval.addEventListener("change", sync)
							sync()
						})()
					</script>
					<button type="submit" class="btn btn-success btn-lg">Create Chore Reminder</button>
				</form>
			</div>
		</div>
	}
}
