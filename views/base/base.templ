package views

import (
	"goDoChores/routes"
	"goDoChores/static"
)

templ Navbar(page string) {
	<nav class="navbar navbar-expand-md custom-navbar">
		<div class="container-fluid">
			<a class="navbar-brand custom-brand" href={ templ.URL(routes.URLFor("home")) }>Go Do Chores</a>
			<button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarSupportedContent">
				<ul class="navbar-nav me-auto mb-2 mb-lg-0">
					<li class="nav-item">
						<a class={ "nav-link custom-nav-link", templ.KV("active", page == "home") } aria-current="page" href={ templ.URL(routes.URLFor("home")) }>Home</a>
					</li>
					<li class="nav-item dropdown">
						<a class={ "nav-link dropdown-toggle custom-nav-link", templ.KV("active", page == "chores") } href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							Chores
						</a>
						<ul class="dropdown-menu custom-dropdown">
							<li><a class="dropdown-item custom-dropdown-item" href={ templ.URL(routes.URLFor("choresList")) }>View All</a></li>
							<li><a class="dropdown-item custom-dropdown-item" href={ templ.URL(routes.URLFor("choresCreate")) }>Create New</a></li>
						</ul>
					</li>
					<li class="nav-item dropdown">
						<a class={ "nav-link dropdown-toggle custom-nav-link", templ.KV("active", page == "tasks") } href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
							Tasks
						</a>
						<ul class="dropdown-menu custom-dropdown">
							<li><a class="dropdown-item custom-dropdown-item" href={ templ.URL(routes.URLFor("tasksList")) }>View All</a></li>
							<li><a class="dropdown-item custom-dropdown-item" href={ templ.URL(routes.URLFor("tasksCreate")) }>Create New</a></li>
						</ul>
					</li>
					<li class="nav-item">
						<a class={ "nav-link custom-nav-link", templ.KV("active", page == "groups") } href={ templ.URL(routes.URLFor("groups")) }>Group</a>
					</li>
				</ul>
				<ul class="navbar-nav mb-2 mb-lg-0">
					<li class="nav-item">
						<form method="post" action={ templ.URL(routes.URLFor("logout")) }>
							<button class="nav-link custom-nav-link custom-logout-btn" aria-current="page" type="submit">Logout</button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</nav>
}

templ Head() {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>Go Do Chores</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet"/>
		<link href={ static.StylesURL() } rel="stylesheet"/>
		{ children... }
	</head>
}

templ Footer() {
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	{ children... }
}

templ Base(page string) {
	<!DOCTYPE html>
	<html lang="en">
		@Head()
		<body class="min-vh-100">
			@Navbar(page)
			<div class="container main-panel">
				{ children... }
			</div>
			@Footer()
		</body>
	</html>
}
